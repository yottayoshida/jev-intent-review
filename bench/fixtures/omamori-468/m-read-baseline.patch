From 8bb77196870593a2598886b4f55d4d7e7788f961 Mon Sep 17 00:00:00 2001
From: yotta <yoshida02@gmail.com>
Date: Sun, 20 Sep 2026 21:11:39 +0900
Subject: [PATCH] m-read-baseline: an unreadable baseline comes back as 'there
 is no baseline'

---
 src/integrity.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/integrity.rs b/src/integrity.rs
index 993cffb..efa6ec9 100644
--- a/src/integrity.rs
+++ b/src/integrity.rs
@@ -213,7 +213,10 @@ pub fn read_baseline(base_dir: &Path) -> Result<Option<IntegrityBaseline>, AppEr
     if !path.exists() {
         return Ok(None);
     }
-    let content = crate::atomic_file::read_to_string_capped(&path, MAX_TRACKED_FILE_BYTES)?;
+    let Ok(content) = crate::atomic_file::read_to_string_capped(&path, MAX_TRACKED_FILE_BYTES)
+    else {
+        return Ok(None);
+    };
     let baseline: IntegrityBaseline =
         serde_json::from_str(&content).map_err(|e| AppError::Config(e.to_string()))?;
     Ok(Some(baseline))
-- 
2.39.5 (Apple Git-154)

