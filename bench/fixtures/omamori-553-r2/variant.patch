 src/cli/doctor.rs | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/src/cli/doctor.rs b/src/cli/doctor.rs
index fdea375..55032da 100644
--- a/src/cli/doctor.rs
+++ b/src/cli/doctor.rs
@@ -741,10 +741,7 @@ fn staging_info_from(
         count += 1;
         bytes += m.len();
         let mtime = m.modified().unwrap_or(now);
