{
  "name": "jev-intent-review",
  "version": "0.0.0",
  "description": "Verify a pull request against the intent that caused it, across the whole repository, with small typed judgments from Jev",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yottayoshida/jev-intent-review.git"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.ts\"",
    "probe:jev": "node bench/probe-jev.ts"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
