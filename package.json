{
  "name": "jev-intent-review",
  "version": "0.1.1",
  "description": "Review pull requests against their intent beyond the boundaries of the diff, using typed judgments from Jev",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yottayoshida/jev-intent-review.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build",
    "probe:jev": "node bench/probe-jev.ts"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "jev-intent-review": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "code-review",
    "pull-request",
    "workers-ai",
    "jev",
    "rust"
  ],
  "publishConfig": {
    "access": "public"
  }
}
